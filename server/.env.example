# 数据库
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ai_saas

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-secret-key
JWT_REFRESH_SECRET=your-refresh-secret
JWT_EXPIRES_IN=7d

# Server
PORT=3000
NODE_ENV=development

# Mock
MOCK_ENABLED=true

# ========== 通联支付聚合收银台 ==========
ALLINPAY_ENV=sandbox
ALLINPAY_CUSID=
ALLINPAY_APPID=
ALLINPAY_PRIVATE_KEY_PATH=./certs/allinpay_private.pem
ALLINPAY_PUBLIC_KEY_PATH=./certs/allinpay_public.pem
ALLINPAY_NOTIFY_URL=https://your-domain.com/api/allinpay/notify
ALLINPAY_RETURN_URL=https://your-domain.com/payment/result
ALLINPAY_SIGN_TYPE=RSA

# ========== v4.1 AI 模型端点 ==========
SEEDANCE_ENDPOINT=
SEEDANCE_API_KEY=
TONGYI_WANXIANG_ENDPOINT=
TONGYI_API_KEY=
QWEN_ENDPOINT=
QWEN_API_KEY=

# ========== v4.1 安全 ==========
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200
CSRF_SECRET=your-csrf-secret
CONTENT_MODERATION_ENABLED=false
