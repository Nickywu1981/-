# ========== 数据库 ==========
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ai_saas
DB_PASSWORD=ai_saas_pass
DB_NAME=ai_saas
DB_POOL_SIZE=20

# ========== Redis ==========
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=ai_saas_redis

# ========== JWT ==========
JWT_SECRET=your-secret-key
JWT_REFRESH_SECRET=your-refresh-secret
JWT_EXPIRES_IN=7d
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# 兼容旧命名（优先级低于 _IN 版本）
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ========== Server ==========
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
CLIENT_PORT=3000
CLIENT_TARGET=http://localhost:3000
APP_URL=http://localhost:3000

# ========== WebSocket ==========
WS_MAX_CONN_PER_IP=5
WS_HEARTBEAT_MS=30000
WS_HEARTBEAT_THRESHOLD_MS=60000

# ========== Encryption ==========
ENCRYPTION_KEY=abcdefghijklmnopqrstuvwxyz123456

# ========== Upload ==========
UPLOAD_DIR=./uploads
UPLOAD_DAILY_LIMIT_MB=2048
ALLOWED_UPLOAD_TYPES=jpg,jpeg,png,webp,gif,svg,mp4,webm,mov,avi
STORAGE_DRIVER=minio
STORAGE_PROVIDER=minio

# ========== MinIO / S3 ==========
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=ai-saas
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
CDN_BASE_URL=

# ========== 腾讯云 COS ==========
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-guangzhou
CDN_DOMAIN=
IMAGE_DOMAIN=
VIDEO_DOMAIN=

# ========== 通联支付 ==========
ALLINPAY_ENV=sandbox
ALLINPAY_CUSID=
ALLINPAY_APPID=
ALLINPAY_PRIVATE_KEY_PATH=./certs/allinpay_private.pem
ALLINPAY_PUBLIC_KEY_PATH=./certs/allinpay_public.pem
ALLINPAY_NOTIFY_URL=https://your-domain.com/api/allinpay/notify
ALLINPAY_RETURN_URL=https://your-domain.com/payment/result
ALLINPAY_FRONT_URL=https://your-domain.com/payment/complete
ALLINPAY_SIGN_TYPE=RSA

# ========== AI 模型 API ==========
OPENAI_API_KEY=sk-your-openai-key
OPENAI_BASE_URL=https://api.openai.com/v1
CLAUDE_API_KEY=sk-ant-your-claude-key
CLAUDE_BASE_URL=https://api.anthropic.com/v1
SD_API_URL=http://localhost:7860
REPLICATE_API_KEY=r8_your-replicate-key
REPLICATE_BASE_URL=https://api.replicate.com/v1
STABILITY_API_KEY=
STABILITY_BASE_URL=https://api.stability.ai
AI_TIMEOUT_MS=120000

# ========== 速率限制 ==========
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_CODE_MAX=1
RATE_LIMIT_HEAVY_MAX=30
RATE_LIMIT_UPLOAD_MAX=20
RATE_LIMIT_PAYMENT_MAX=15
RATE_LIMIT_ADMIN_MAX=60
RATE_LIMIT_CONCURRENCY_MAX=6
RATE_LIMIT_AI_CONCURRENCY_MAX=3
RATE_LIMIT_VERIFY_MAX=5

# ========== 短信 ==========
SMS_PROVIDER=mock
SMS_SIGN_NAME=AI电商工具箱
SMS_ALI_ACCESS_KEY_ID=
SMS_ALI_ACCESS_KEY_SECRET=
SMS_TENCENT_SECRET_ID=
SMS_TENCENT_SECRET_KEY=
SMS_TENCENT_APP_ID=

# ========== 邮件 ==========
EMAIL_PROVIDER=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ========== Worker ==========
WORKER_POLL_INTERVAL=5000
WORKER_BATCH_SIZE=3
WORKER_MAX_CONCURRENT=5

# ========== BullMQ ==========
BULL_IMAGE_CONCURRENCY=3
BULL_VIDEO_CONCURRENCY=2
BULL_BATCH_CONCURRENCY=5
BULL_NOTIFY_CONCURRENCY=2

# ========== TTS / 语音 ==========
ELEVENLABS_API_KEY=
ELEVENLABS_API_URL=https://api.elevenlabs.io
EDGE_TTS_WS_URL=wss://speech.platform.bing.com/consumer/speech/synthesize/readaloud/edge/v1?TrustedClientToken=6A5AA1D4EAFF4E9FB37E23D68491D6F4
EDGE_TTS_TRUSTED_TOKEN=
EDGE_TTS_ORIGIN=chrome-extension://jdiccldimpdaibmpdkjnbmckianbfold

# ========== GEO-IP ==========
GEOIP_API_URL=https://ip-api.com/json

# ========== 安全 ==========
CSRF_SECRET=
CONTENT_MODERATION_ENABLED=false

# ========== E2B Cloud Sandbox ==========
E2B_API_KEY=
E2B_TEMPLATE=code-interpreter-v2
E2B_TIMEOUT_MS=300000
E2B_MAX_PER_USER=3

# ========== 管理员 ==========
ADMIN_PASSWORD=

# ========== 日志 ==========
LOG_LEVEL=info
LOG_SAMPLE_RATE=1.0
SLOW_QUERY_MS=500

# ========== Mock ==========
MOCK_ENABLED=true
