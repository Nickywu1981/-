# 数据库
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ai_saas

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-secret-key
JWT_REFRESH_SECRET=your-refresh-secret
JWT_EXPIRES_IN=7d

# Server
PORT=3001
NODE_ENV=development

# Client (SSR target)
CLIENT_PORT=3000
CLIENT_TARGET=http://localhost:3000

# Encryption (for config values, API keys at rest)
ENCRYPTION_KEY=your-32-char-encryption-key-here

# Mock
MOCK_ENABLED=true

# ========== 通联支付聚合收银台 ==========
ALLINPAY_ENV=sandbox
ALLINPAY_CUSID=
ALLINPAY_APPID=
ALLINPAY_PRIVATE_KEY_PATH=./certs/allinpay_private.pem
ALLINPAY_PUBLIC_KEY_PATH=./certs/allinpay_public.pem
ALLINPAY_NOTIFY_URL=https://your-domain.com/api/allinpay/notify
ALLINPAY_RETURN_URL=https://your-domain.com/payment/result
ALLINPAY_FRONT_URL=https://your-domain.com/payment/complete
ALLINPAY_SIGN_TYPE=RSA

# ========== AI 模型 API Keys ==========
# OpenAI GPT-4o / GPT-4o-mini / DALL-E 3
OPENAI_API_KEY=sk-your-openai-key
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude Sonnet 4.6 / Haiku 4.5
CLAUDE_API_KEY=sk-ant-your-claude-key
CLAUDE_BASE_URL=https://api.anthropic.com/v1

# Stable Diffusion / Replicate
SD_API_URL=http://localhost:7860
REPLICATE_API_KEY=r8_your-replicate-key

# 视频模型（预留）
SEEDANCE_API_KEY=
TONGYI_API_KEY=
QWEN_API_KEY=

# ========== v4.1 安全 ==========
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200
CSRF_SECRET=your-csrf-secret
CONTENT_MODERATION_ENABLED=false

# ========== 短信服务 ==========
SMS_PROVIDER=mock
SMS_SIGN_NAME=AI电商工具箱
SMS_ALI_ACCESS_KEY_ID=
SMS_ALI_ACCESS_KEY_SECRET=
SMS_TENCENT_SECRET_ID=
SMS_TENCENT_SECRET_KEY=
SMS_TENCENT_APP_ID=

# ========== 邮件服务 ==========
EMAIL_PROVIDER=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ========== 对象存储（MinIO/COS） ==========
STORAGE_DRIVER=minio
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=ai-saas
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
CDN_DOMAIN=
IMAGE_DOMAIN=
VIDEO_DOMAIN=
CDN_BASE_URL=

# ========== 上传配置 ==========
ALLOWED_UPLOAD_TYPES=image/jpeg,image/png,image/webp,image/gif,image/svg+xml,video/mp4,video/webm

# ========== BullMQ 队列并发 ==========
BULL_IMAGE_CONCURRENCY=3
BULL_VIDEO_CONCURRENCY=2
BULL_BATCH_CONCURRENCY=5
BULL_NOTIFY_CONCURRENCY=2

# ========== TTS/语音 ==========
ELEVENLABS_API_KEY=

# ========== 数据库连接池 ==========
DB_POOL_SIZE=20

# ========== JWT 过期时间 ==========
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ========== 应用 URL ==========
APP_URL=http://localhost:3000

# ========== MinIO 管理账号 ==========
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme

# ========== Replicate/Stability AI ==========
REPLICATE_BASE_URL=https://api.replicate.com/v1
STABILITY_API_KEY=
STABILITY_BASE_URL=
