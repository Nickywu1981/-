# ========== Docker 环境变量 ==========

# 数据库
DB_ROOT_PASSWORD=root123
DB_USER=ai_saas
DB_PASSWORD=ai_saas_pass
DB_PORT=3306

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=ai_saas_redis

# 服务端口
SERVER_PORT=3001
CLIENT_PORT=3000

# 运行环境
NODE_ENV=development

# JWT（生产务必更换为至少32字符的强随机字符串）
JWT_SECRET=change-me-in-production-32-characters-min
JWT_REFRESH_SECRET=change-me-refresh-secret-32-chars-min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_KEY=change-me-in-production-exactly-32-bytes

# AI 模型（生产必填）
# OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1

# 通联支付（生产必填）
# ALLINPAY_CUSID=your-cusid
# ALLINPAY_APPID=your-appid
# ALLINPAY_PUBLIC_KEY=your-allinpay-public-key
# ALLINPAY_PRIVATE_KEY=your-private-key
# ALLINPAY_NOTIFY_URL=https://your-domain.com/api/recharge/callback

# 通知服务（生产改为真实 provider，不可用 mock）
# SMS_PROVIDER=aliyun
# EMAIL_PROVIDER=sendgrid
# ALIYUN_ACCESS_KEY_ID=your-ali-key
# ALIYUN_ACCESS_KEY_SECRET=your-ali-secret
# SENDGRID_API_KEY=your-sendgrid-key
# EMAIL_FROM=noreply@example.com

# WebSocket
# WS_MAX_CONN_PER_IP=5
# WS_HEARTBEAT_MS=30000
# WS_HEARTBEAT_THRESHOLD_MS=60000

# 限流配置（均可选，有默认值）
# RATE_LIMIT_AUTH_MAX=10
# RATE_LIMIT_CODE_MAX=1
# RATE_LIMIT_VERIFY_MAX=5
# RATE_LIMIT_HEAVY_MAX=30
# RATE_LIMIT_UPLOAD_MAX=20
# RATE_LIMIT_PAYMENT_MAX=15
# RATE_LIMIT_ADMIN_MAX=60
# RATE_LIMIT_CONCURRENCY_MAX=6
# RATE_LIMIT_AI_CONCURRENCY_MAX=3

# Mock
MOCK_ENABLED=true

# 对象存储
STORAGE_DRIVER=minio
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# S3/MinIO
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=changeme

# 客户端构建
CLIENT_TARGET=dev
NUXT_PUBLIC_API_BASE=http://localhost:3001/api
