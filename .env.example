# ========== Docker 环境变量 ==========

# 数据库
DB_ROOT_PASSWORD=root123
DB_USER=ai_saas
DB_PASSWORD=ai_saas_pass
DB_PORT=3306

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=ai_saas_redis

# 服务端口
SERVER_PORT=3001
CLIENT_PORT=3000

# 运行环境
NODE_ENV=development

# JWT（生产务必更换为至少32字符的强随机字符串）
JWT_SECRET=change-me-in-production-32-characters-min
JWT_REFRESH_SECRET=change-me-refresh-secret-32-chars-min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_KEY=your-32-char-encryption-key-here-change-it

# 限流配置（均可选，有默认值）
# RATE_LIMIT_AUTH_MAX=10
# RATE_LIMIT_CODE_MAX=1
# RATE_LIMIT_VERIFY_MAX=5
# RATE_LIMIT_HEAVY_MAX=30
# RATE_LIMIT_UPLOAD_MAX=20
# RATE_LIMIT_PAYMENT_MAX=15
# RATE_LIMIT_ADMIN_MAX=60
# RATE_LIMIT_CONCURRENCY_MAX=6
# RATE_LIMIT_AI_CONCURRENCY_MAX=3

# Mock
MOCK_ENABLED=true

# 对象存储
STORAGE_DRIVER=minio
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# S3/MinIO
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=changeme

# 客户端构建
CLIENT_TARGET=dev
NUXT_PUBLIC_API_BASE=http://localhost:3001/api
