# ========== Docker 环境变量 ==========

# 数据库
DB_PASSWORD=root123
DB_PORT=3306

# Redis
REDIS_PORT=6379

# 服务端口
SERVER_PORT=3001
CLIENT_PORT=3000

# 运行环境
NODE_ENV=development

# Mock 模式（开发默认开启，false=用真实DB）
MOCK_ENABLED=true

# JWT（生产务必更换）
JWT_SECRET=change-me-in-production

# 客户端构建目标（dev | prod）
CLIENT_TARGET=dev
