# ============================================================
# Movio AI / MemFocus AI — 环境变量模板
# 复制为 .env 后填入实际值
# ============================================================

# ---- 运行环境 ----
NODE_ENV=development
PORT=3001
CLIENT_PORT=3000

# ---- 数据库 MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=ai_saas
DB_PASSWORD=change_me_db_password
DB_NAME=ai_saas
DB_POOL_SIZE=20
DB_ROOT_PASSWORD=root123

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=ai_saas_redis

# ---- JWT 认证 ----
JWT_SECRET=change-me-in-production-32-characters-min
JWT_REFRESH_SECRET=change-me-refresh-secret-32-chars-min
JWT_EXPIRES_IN=7d
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_KEY=change-me-32-byte-encryption!!

# ---- AI / 大模型 ----
# OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_MS=300000
# REPLICATE_BASE_URL=https://api.replicate.com/v1

# ---- 限流 (均可选，有默认值) ----
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=200
# RATE_LIMIT_AUTH_MAX=10
# RATE_LIMIT_CODE_MAX=1
# RATE_LIMIT_HEAVY_MAX=30
# RATE_LIMIT_UPLOAD_MAX=20
# RATE_LIMIT_PAYMENT_MAX=15
# RATE_LIMIT_ADMIN_MAX=60
# RATE_LIMIT_CONCURRENCY_MAX=6
# RATE_LIMIT_AI_CONCURRENCY_MAX=3
# RATE_LIMIT_VERIFY_MAX=5

# ---- CORS ----
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# ---- 日志 ----
LOG_LEVEL=info
LOG_SAMPLE_RATE=1.0
SLOW_QUERY_MS=1000

# ---- 文件上传 ----
# UPLOAD_DAILY_LIMIT_MB=2048
# ALLOWED_UPLOAD_TYPES=jpg,jpeg,png,webp,mp4,mov,avi,webm

# ---- 应用 URL ----
APP_URL=https://movio.ai

# ---- 存储 (local | minio | cos | s3) ----
STORAGE_DRIVER=minio
# 腾讯云 COS
# COS_SECRET_ID=
# COS_SECRET_KEY=
# COS_BUCKET=
# COS_REGION=ap-guangzhou
# CDN_DOMAIN=
# CDN_BASE_URL=
# S3/MinIO
S3_ENDPOINT=http://minio:9000
S3_BUCKET=ai-saas
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=changeme
S3_FORCE_PATH_STYLE=true

# ---- 短信 (生产必填，不可用 mock) ----
SMS_PROVIDER=mock
# SMS_PROVIDER=aliyun
# SMS_SIGN_NAME=AI电商工具箱
# SMS_ALI_ACCESS_KEY_ID=
# SMS_ALI_ACCESS_KEY_SECRET=
# SMS_TENCENT_SECRET_ID=
# SMS_TENCENT_SECRET_KEY=
# SMS_TENCENT_APP_ID=

# ---- 邮件 (生产必填，不可用 mock) ----
EMAIL_PROVIDER=mock
# EMAIL_PROVIDER=sendgrid
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# ---- 支付 (通联 AllInPay，生产必填) ----
ALLINPAY_ENV=sandbox
# ALLINPAY_CUSID=
# ALLINPAY_APPID=
# ALLINPAY_PRIVATE_KEY_PATH=./certs/allinpay_private.pem
# ALLINPAY_PUBLIC_KEY_PATH=./certs/allinpay_public.pem
# ALLINPAY_NOTIFY_URL=
# ALLINPAY_RETURN_URL=
# ALLINPAY_FRONT_URL=

# ---- WebSocket ----
# WS_MAX_CONN_PER_IP=5
# WS_HEARTBEAT_MS=30000
# WS_HEARTBEAT_THRESHOLD_MS=60000

# ---- Worker ----
# WORKER_POLL_INTERVAL=2000
# WORKER_BATCH_SIZE=3
# WORKER_MAX_CONCURRENT=5

# ---- BullMQ 队列 ----
# BULL_IMAGE_CONCURRENCY=3
# BULL_VIDEO_CONCURRENCY=2
# BULL_BATCH_CONCURRENCY=5
# BULL_NOTIFY_CONCURRENCY=10

# ---- MinIO (开发环境) ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- Mock 模式 ----
MOCK_ENABLED=true

# ---- 客户端构建 ----
CLIENT_TARGET=dev
NUXT_PUBLIC_API_BASE=http://localhost:3001/api

# ---- 各 AI 服务 Adapter (可选) ----
# STABILITY_API_KEY=
# CLAUDE_API_KEY=
# SD_API_URL=http://localhost:7860
# REPLICATE_API_KEY=
# ELEVENLABS_API_KEY=
